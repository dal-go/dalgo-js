{
 "cases": [
  {"name": "94 flat join: field key on an aliased group column", "query": {"from": {"database": "chinook", "name": "Invoice", "alias": "i", "joins": [{"from": {"database": "geo", "name": "country_aliases", "alias": "a"}, "on": [{"left": {"field": "BillingCountry", "source": "i"}, "op": "==", "right": {"field": "alias", "source": "a"}}]}]}, "groupBy": [{"field": "country", "source": "a"}], "columns": [{"field": "country", "source": "a", "as": "iso"}, {"aggregate": {"function": "sum", "args": [{"field": "Total", "source": "i"}]}, "as": "total"}], "orderBy": [{"field": "country", "source": "a", "desc": true}, {"aggregate": {"function": "sum", "args": [{"field": "Total", "source": "i"}]}, "desc": true}]}},
  {"name": "95 flat join: field key beside an aggregate expression key", "query": {"from": {"database": "chinook", "name": "Invoice", "alias": "i", "joins": [{"from": {"database": "geo", "name": "country_aliases", "alias": "a"}, "on": [{"left": {"field": "BillingCountry", "source": "i"}, "op": "==", "right": {"field": "alias", "source": "a"}}]}]}, "groupBy": [{"field": "country", "source": "a"}], "columns": [{"field": "country", "source": "a", "as": "iso"}, {"aggregate": {"function": "sum", "args": [{"field": "Total", "source": "i"}]}, "as": "total"}], "orderBy": [{"aggregate": {"function": "count", "args": [{"star": true}]}, "desc": true}, {"field": "country", "source": "a"}]}},
  {"name": "96 flat join: aggregate expression key then field key", "query": {"from": {"database": "chinook", "name": "Invoice", "alias": "i", "joins": [{"from": {"database": "geo", "name": "country_aliases", "alias": "a"}, "on": [{"left": {"field": "BillingCountry", "source": "i"}, "op": "==", "right": {"field": "alias", "source": "a"}}]}]}, "groupBy": [{"field": "country", "source": "a"}], "columns": [{"field": "country", "source": "a", "as": "iso"}], "orderBy": [{"aggregate": {"function": "sum", "args": [{"field": "Total", "source": "i"}]}, "desc": true}, {"field": "country", "source": "a", "desc": true}]}},
  {"name": "97 flat join: aggregate only in the order key, no columns", "query": {"from": {"database": "chinook", "name": "Invoice", "alias": "i", "joins": [{"from": {"database": "geo", "name": "country_aliases", "alias": "a"}, "on": [{"left": {"field": "BillingCountry", "source": "i"}, "op": "==", "right": {"field": "alias", "source": "a"}}]}]}, "orderBy": [{"aggregate": {"function": "count", "args": [{"star": true}]}}]}},
  {"name": "98 flat join: aggregates over zero rows give one row", "query": {"from": {"database": "chinook", "name": "Invoice", "alias": "i", "joins": [{"from": {"database": "geo", "name": "country_aliases", "alias": "a"}, "on": [{"left": {"field": "BillingCountry", "source": "i"}, "op": "==", "right": {"field": "alias", "source": "a"}}]}]}, "where": {"left": {"field": "BillingCountry", "source": "i"}, "op": "==", "right": {"value": "Nowhere"}}, "columns": [{"aggregate": {"function": "count", "args": [{"star": true}]}, "as": "n"}, {"aggregate": {"function": "sum", "args": [{"field": "Total", "source": "i"}]}, "as": "total"}, {"aggregate": {"function": "avg", "args": [{"field": "Total", "source": "i"}]}, "as": "mean"}, {"aggregate": {"function": "max", "args": [{"field": "Total", "source": "i"}]}, "as": "top"}]}},
  {"name": "99 flat join: HAVING without any aggregate keeps the implicit group", "query": {"from": {"database": "chinook", "name": "Invoice", "alias": "i", "joins": [{"from": {"database": "geo", "name": "country_aliases", "alias": "a"}, "on": [{"left": {"field": "BillingCountry", "source": "i"}, "op": "==", "right": {"field": "alias", "source": "a"}}]}]}, "groupBy": [{"field": "country", "source": "a"}], "columns": [{"field": "country", "source": "a", "as": "iso"}], "having": {"left": {"field": "country", "source": "a"}, "op": "==", "right": {"value": "USA"}}}},
  {"name": "100 flat join: count distinct falls back to the generic plan", "query": {"from": {"database": "chinook", "name": "Invoice", "alias": "i", "joins": [{"from": {"database": "geo", "name": "country_aliases", "alias": "a"}, "on": [{"left": {"field": "BillingCountry", "source": "i"}, "op": "==", "right": {"field": "alias", "source": "a"}}]}]}, "groupBy": [{"field": "country", "source": "a"}], "columns": [{"field": "country", "source": "a", "as": "iso"}, {"aggregate": {"function": "count", "args": [{"field": "Total", "source": "i"}], "distinct": true}, "as": "distinctTotals"}, {"aggregate": {"function": "count", "args": [{"star": true}]}, "as": "invoices"}], "orderBy": [{"aggregate": {"function": "count", "args": [{"field": "Total", "source": "i"}], "distinct": true}, "desc": true}, {"field": "country", "source": "a"}]}},
  {"name": "101 flat join: first and last keep null values", "query": {"from": {"database": "chinook", "name": "Sale", "alias": "s", "joins": [{"from": {"database": "chinook", "name": "Dim", "alias": "d"}, "on": [{"left": {"field": "k", "source": "s"}, "op": "==", "right": {"field": "k", "source": "d"}}]}]}, "groupBy": [{"field": "artist", "source": "s"}], "columns": [{"field": "artist", "source": "s"}, {"aggregate": {"function": "first", "args": [{"field": "note", "source": "s"}]}, "as": "firstNote"}, {"aggregate": {"function": "last", "args": [{"field": "note", "source": "s"}]}, "as": "lastNote"}], "orderBy": [{"field": "artist", "source": "s"}]}},
  {"name": "102 flat join: left join keeps unmatched groups", "query": {"from": {"database": "chinook", "name": "Invoice", "alias": "i", "joins": [{"type": "left", "from": {"database": "geo", "name": "country_aliases", "alias": "a"}, "on": [{"left": {"field": "BillingCountry", "source": "i"}, "op": "==", "right": {"field": "alias", "source": "a"}}]}]}, "groupBy": [{"field": "BillingCountry", "source": "i"}], "columns": [{"field": "BillingCountry", "source": "i", "as": "billing"}, {"aggregate": {"function": "count", "args": [{"star": true}]}, "as": "n"}], "orderBy": [{"aggregate": {"function": "count", "args": [{"star": true}]}, "desc": true}, {"field": "BillingCountry", "source": "i"}]}}
 ]
