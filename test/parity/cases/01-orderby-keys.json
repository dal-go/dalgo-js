{
 "cases": [
  {"name": "01 saved per-capita fixture (desc, tie, div-by-zero)", "yamlFile": "../testdata/orderby/chinook-sales-per-capita.dtql.yaml"},
  {"name": "02 saved per-capita asc (NULL first)", "yamlFile": "../testdata/orderby/chinook-sales-per-capita.dtql.yaml", "yamlReplace": [["    desc: true", "    desc: false"]]},
  {"name": "03 saved per-capita offset 1 limit 2", "yamlFile": "../testdata/orderby/chinook-sales-per-capita.dtql.yaml", "yamlAppend": "offset: 1\nlimit: 2\n"},
  {"name": "04 unprojected aggregate key desc + group field tiebreak", "query": {"from": {"database": "chinook", "name": "Invoice", "alias": "i"}, "groupBy": [{"field": "BillingCountry", "source": "i"}], "columns": [{"field": "BillingCountry", "source": "i", "as": "country"}], "orderBy": [{"aggregate": {"function": "sum", "args": [{"field": "Total", "source": "i"}]}, "desc": true}, {"field": "BillingCountry", "source": "i"}]}},
  {"name": "05 ungrouped expr key over nested join (0 - population)", "query": {"from": {"database": "geo", "name": "country_aliases", "alias": "a", "joins": [{"from": {"database": "geo", "name": "population_wb", "alias": "p"}, "on": [{"left": {"field": "country", "source": "a"}, "op": "==", "right": {"field": "country", "source": "p"}}]}]}, "columns": [{"field": "alias", "source": "a", "as": "country"}], "orderBy": [{"binary": {"op": "-", "left": {"value": 0}, "right": {"field": "population", "source": "p"}}}]}},
  {"name": "06 constant key desc (stable)", "query": {"from": {"database": "chinook", "name": "Sale", "alias": "s", "joins": [{"from": {"database": "chinook", "name": "Dim", "alias": "d"}, "on": [{"left": {"field": "k", "source": "s"}, "op": "==", "right": {"field": "k", "source": "d"}}]}]}, "columns": [{"field": "id", "source": "s"}], "orderBy": [{"value": 1, "desc": true}]}},
  {"name": "07 aggregate-only key, no columns, no groupBy", "query": {"from": {"database": "chinook", "name": "Sale", "alias": "s"}, "orderBy": [{"aggregate": {"function": "count", "args": [{"star": true}]}}]}},
  {"name": "08 ungrouped NULL operand asc (qty*price), single source", "query": {"from": {"database": "chinook", "name": "Sale", "alias": "s", "joins": [{"from": {"database": "chinook", "name": "Dim", "alias": "d"}, "on": [{"left": {"field": "k", "source": "s"}, "op": "==", "right": {"field": "k", "source": "d"}}]}]}, "columns": [{"field": "id", "source": "s"}, {"binary": {"op": "*", "left": {"field": "qty", "source": "s"}, "right": {"field": "price", "source": "s"}}, "as": "v"}], "orderBy": [{"binary": {"op": "*", "left": {"field": "qty", "source": "s"}, "right": {"field": "price", "source": "s"}}}]}},
  {"name": "09 ungrouped NULL operand desc (qty*price)", "query": {"from": {"database": "chinook", "name": "Sale", "alias": "s", "joins": [{"from": {"database": "chinook", "name": "Dim", "alias": "d"}, "on": [{"left": {"field": "k", "source": "s"}, "op": "==", "right": {"field": "k", "source": "d"}}]}]}, "columns": [{"field": "id", "source": "s"}], "orderBy": [{"binary": {"op": "*", "left": {"field": "qty", "source": "s"}, "right": {"field": "price", "source": "s"}}, "desc": true}]}},
  {"name": "10 mixed field desc + expression asc (ungrouped)", "query": {"from": {"database": "chinook", "name": "Sale", "alias": "s", "joins": [{"from": {"database": "chinook", "name": "Dim", "alias": "d"}, "on": [{"left": {"field": "k", "source": "s"}, "op": "==", "right": {"field": "k", "source": "d"}}]}]}, "columns": [{"field": "id", "source": "s"}, {"field": "artist", "source": "s"}], "orderBy": [{"field": "artist", "source": "s", "desc": true}, {"binary": {"op": "-", "left": {"value": 0}, "right": {"field": "id", "source": "s"}}}]}},
  {"name": "11 ungrouped division by zero key + column (qty/price)", "query": {"from": {"database": "chinook", "name": "Sale", "alias": "s", "joins": [{"from": {"database": "chinook", "name": "Dim", "alias": "d"}, "on": [{"left": {"field": "k", "source": "s"}, "op": "==", "right": {"field": "k", "source": "d"}}]}]}, "columns": [{"field": "id", "source": "s"}, {"binary": {"op": "/", "left": {"field": "qty", "source": "s"}, "right": {"field": "price", "source": "s"}}, "as": "r"}], "orderBy": [{"binary": {"op": "/", "left": {"field": "qty", "source": "s"}, "right": {"field": "price", "source": "s"}}, "desc": true}, {"field": "id", "source": "s"}]}},
  {"name": "12 grouped: expr key count desc, ties (jazz-style top artists)", "query": {"from": {"database": "chinook", "name": "Sale", "alias": "s"}, "groupBy": [{"field": "artist", "source": "s"}], "columns": [{"field": "artist", "source": "s"}, {"aggregate": {"function": "count", "args": [{"star": true}]}, "as": "purchases"}], "orderBy": [{"aggregate": {"function": "count", "args": [{"star": true}]}, "desc": true}], "limit": 3}},
  {"name": "13 alias order key (field: purchases, no source)", "query": {"from": {"database": "chinook", "name": "Sale", "alias": "s"}, "groupBy": [{"field": "artist", "source": "s"}], "columns": [{"field": "artist", "source": "s"}, {"aggregate": {"function": "count", "args": [{"star": true}]}, "as": "purchases"}], "orderBy": [{"field": "purchases", "desc": true}]}},
  {"name": "14 non-numeric arithmetic key (note + 1)", "query": {"from": {"database": "chinook", "name": "Sale", "alias": "s", "joins": [{"from": {"database": "chinook", "name": "Dim", "alias": "d"}, "on": [{"left": {"field": "k", "source": "s"}, "op": "==", "right": {"field": "k", "source": "d"}}]}]}, "columns": [{"field": "id", "source": "s"}], "orderBy": [{"binary": {"op": "+", "left": {"field": "note", "source": "s"}, "right": {"value": 1}}}, {"field": "id", "source": "s", "desc": true}]}},
  {"name": "15 grouped ORDER BY on non-grouped field", "query": {"from": {"database": "chinook", "name": "Sale", "alias": "s"}, "groupBy": [{"field": "artist", "source": "s"}], "columns": [{"field": "artist", "source": "s"}], "orderBy": [{"field": "id", "source": "s", "desc": true}]}},
  {"name": "16 grouped ORDER BY expr over non-grouped field (0 - id)", "query": {"from": {"database": "chinook", "name": "Sale", "alias": "s"}, "groupBy": [{"field": "artist", "source": "s"}], "columns": [{"field": "artist", "source": "s"}], "orderBy": [{"binary": {"op": "-", "left": {"value": 0}, "right": {"field": "id", "source": "s"}}}]}},
  {"name": "17 mixed-type field key (note: string/number/bool/null)", "query": {"from": {"database": "chinook", "name": "Sale", "alias": "s", "joins": [{"from": {"database": "chinook", "name": "Dim", "alias": "d"}, "on": [{"left": {"field": "k", "source": "s"}, "op": "==", "right": {"field": "k", "source": "d"}}]}]}, "columns": [{"field": "id", "source": "s"}, {"field": "note", "source": "s"}], "orderBy": [{"field": "note", "source": "s"}]}},
  {"name": "18 flat join grouped, expr key sum/population desc (TS streams with scanPages)", "query": {"from": {"database": "chinook", "name": "Invoice", "alias": "i", "joins": [{"from": {"database": "geo", "name": "country_aliases", "alias": "a"}, "on": [{"left": {"field": "BillingCountry", "source": "i"}, "op": "==", "right": {"field": "alias", "source": "a"}}]}]}, "groupBy": [{"field": "country", "source": "a"}], "columns": [{"field": "country", "source": "a", "as": "country"}, {"aggregate": {"function": "sum", "args": [{"field": "Total", "source": "i"}]}, "as": "total"}], "orderBy": [{"aggregate": {"function": "sum", "args": [{"field": "Total", "source": "i"}]}}, {"field": "country", "source": "a", "desc": true}]}},
  {"name": "19 flat join grouped, field key on projected alias column mismatch", "query": {"from": {"database": "chinook", "name": "Invoice", "alias": "i", "joins": [{"from": {"database": "geo", "name": "country_aliases", "alias": "a"}, "on": [{"left": {"field": "BillingCountry", "source": "i"}, "op": "==", "right": {"field": "alias", "source": "a"}}]}]}, "groupBy": [{"field": "country", "source": "a"}], "columns": [{"field": "country", "source": "a", "as": "iso"}, {"aggregate": {"function": "sum", "args": [{"field": "Total", "source": "i"}]}, "as": "total"}], "orderBy": [{"field": "country", "source": "a", "desc": true}]}},
  {"name": "20 aggregate key with HAVING and avg, grouped", "query": {"from": {"database": "chinook", "name": "Sale", "alias": "s"}, "groupBy": [{"field": "customer", "source": "s"}], "columns": [{"field": "customer", "source": "s"}, {"aggregate": {"function": "avg", "args": [{"field": "qty", "source": "s"}]}, "as": "avgQty"}], "having": {"left": {"aggregate": {"function": "count", "args": [{"star": true}]}}, "op": ">", "right": {"value": 1}}, "orderBy": [{"binary": {"op": "/", "left": {"aggregate": {"function": "sum", "args": [{"field": "qty", "source": "s"}]}}, "right": {"aggregate": {"function": "count", "args": [{"field": "qty", "source": "s"}]}}}, "desc": true}]}},
  {"name": "21 jazz filter + count desc (where on genre)", "query": {"from": {"database": "chinook", "name": "Sale", "alias": "s"}, "where": {"left": {"field": "genre", "source": "s"}, "op": "==", "right": {"value": "Jazz"}}, "groupBy": [{"field": "artist", "source": "s"}], "columns": [{"field": "artist", "source": "s"}, {"aggregate": {"function": "count", "args": [{"field": "customer", "source": "s"}], "distinct": true}, "as": "customers"}], "orderBy": [{"aggregate": {"function": "count", "args": [{"field": "customer", "source": "s"}], "distinct": true}, "desc": true}, {"field": "artist", "source": "s"}]}},
  {"name": "22 empty input, aggregate-only key (implicit group)", "query": {"from": {"database": "chinook", "name": "Empty", "alias": "e"}, "columns": [{"aggregate": {"function": "count", "args": [{"star": true}]}, "as": "n"}], "orderBy": [{"aggregate": {"function": "count", "args": [{"star": true}]}}]}}
 ]
}
