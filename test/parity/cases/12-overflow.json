  {"name": "172 overflowing product as a plain order key", "query": {"from": {"database": "chinook", "name": "Big", "alias": "b", "joins": [{"from": {"database": "chinook", "name": "Big", "alias": "b2"}, "on": [{"left": {"field": "id", "source": "b"}, "op": "==", "right": {"field": "id", "source": "b2"}}]}]}, "columns": [{"field": "id", "source": "b"}], "orderBy": [{"binary": {"op": "*", "left": {"field": "x", "source": "b"}, "right": {"field": "x", "source": "b"}}, "desc": true}, {"field": "id", "source": "b"}]}},
