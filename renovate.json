{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "automerge": false,
  "automergeType": "pr",
  "platformAutomerge": true,
  "prConcurrentLimit": 3,
  "packageRules": [
    {
      "description": "Batch compatible lint-tool updates and let GitHub merge after the required check passes",
      "matchManagers": ["npm"],
      "matchDepTypes": ["devDependencies"],
      "matchPackageNames": ["eslint", "@eslint/js", "typescript-eslint"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "lint tooling",
      "automerge": true
    },
    {
      "description": "List major upgrades in the dashboard for review before opening a PR",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    }
  ]
}
