{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>dal-go/dalgo-renovate-config"],
  "automerge": false,
  "automergeType": "pr",
  "platformAutomerge": true,
  "prConcurrentLimit": 3,
  "packageRules": [
    {
      "description": "Wait for npm releases to clear pnpm's 24-hour install gate",
      "matchDatasources": ["npm"],
      "minimumReleaseAge": "1 day",
      "internalChecksFilter": "strict"
    },
    {
      "description": "Keep TypeScript within the current lint tool peer range",
      "matchManagers": ["npm"],
      "matchPackageNames": ["typescript"],
      "allowedVersions": ">=4.8.4 <6.1.0"
    },
    {
      "description": "Batch compatible lint-tool updates and let GitHub merge after the required check passes",
      "matchManagers": ["npm"],
      "matchDepTypes": ["devDependencies"],
      "matchPackageNames": ["eslint", "@eslint/js", "typescript-eslint"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "lint tooling",
      "automerge": true
    },
    {
      "description": "List major upgrades in the dashboard for review before opening a PR",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    }
  ]
}
